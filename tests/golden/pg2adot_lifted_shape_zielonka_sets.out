digraph attractor_decompositions {
  graph [rankdir=TB, ordering=out];
  node [shape=box];
  result [label="result (synthetic)"];
  result -> even;
  even [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Even</B> <I>d</I> = 4</TD></TR><TR><TD>|<I>W</I>| = 5</TD><TD>|<I>A</I>| = 0</TD></TR><TR><TD>nodes = 4</TD><TD>leaves = 2</TD></TR><TR><TD>height = 3</TD><TD>Strahler = 2</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>W</I> = {0,1,2,3,4}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>A</I> = {}</TD></TR></TABLE>>];
  even -> even_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><I>i</I> = 1</TD></TR><TR><TD>|<I>S</I><SUB><I>i</I></SUB>| = 4</TD><TD>|<I>A</I><SUB><I>i</I></SUB>| = 5</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>S</I><SUB><I>i</I></SUB> = {0,1,2,4}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>A</I><SUB><I>i</I></SUB> = {0,1,2,3,4}</TD></TR></TABLE>>];
  even_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Even</B> <I>d</I> = 2</TD></TR><TR><TD>|<I>W</I>| = 4</TD><TD>|<I>A</I>| = 0</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>W</I> = {0,1,2,4}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>A</I> = {}</TD></TR></TABLE>>];
  even_0 -> even_0_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><I>i</I> = 1</TD></TR><TR><TD>|<I>S</I><SUB><I>i</I></SUB>| = 2</TD><TD>|<I>A</I><SUB><I>i</I></SUB>| = 3</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>S</I><SUB><I>i</I></SUB> = {1,2}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>A</I><SUB><I>i</I></SUB> = {0,1,2}</TD></TR></TABLE>>];
  even_0_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Even</B> <I>d</I> = 0</TD></TR><TR><TD>|<I>W</I>| = 2</TD><TD>|<I>A</I>| = 2</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>W</I> = {1,2}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>A</I> = {1,2}</TD></TR></TABLE>>];
  even_0 -> even_0_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><I>i</I> = 2</TD></TR><TR><TD>|<I>S</I><SUB><I>i</I></SUB>| = 1</TD><TD>|<I>A</I><SUB><I>i</I></SUB>| = 1</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>S</I><SUB><I>i</I></SUB> = {4}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>A</I><SUB><I>i</I></SUB> = {4}</TD></TR></TABLE>>];
  even_0_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Even</B> <I>d</I> = 0</TD></TR><TR><TD>|<I>W</I>| = 1</TD><TD>|<I>A</I>| = 1</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>W</I> = {4}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>A</I> = {4}</TD></TR></TABLE>>];
  odd_empty [label=<<B>Odd</B>: <I>W</I> = empty; no decomposition>];
  result -> odd_empty;
}
