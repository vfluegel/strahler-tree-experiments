digraph attractor_decompositions {
  graph [rankdir=TB, ordering=out];
  node [shape=box];
  result [label="result (synthetic)"];
  even_empty [label="Even: W=empty; no decomposition"];
  result -> even_empty;
  result -> odd;
  odd [label="Odd d=3\n|W|=3 |A|=0\nchildren=2\nnodes=3 leaves=2 height=2 Strahler=2\nW={0,..., +2 more}\nA={}"];
  odd -> odd_0 [label="i=1 |S_i|=1 |A_i|=2\nS_i={1}\nA_i={1,..., +1 more}"];
  odd_0 [label="Odd d=1\n|W|=1 |A|=1\nchildren=0\nnodes=1 leaves=1 height=1 Strahler=1\nW={1}\nA={1}"];
  odd -> odd_1 [label="i=2 |S_i|=1 |A_i|=1\nS_i={0}\nA_i={0}"];
  odd_1 [label="Odd d=1\n|W|=1 |A|=1\nchildren=0\nnodes=1 leaves=1 height=1 Strahler=1\nW={0}\nA={0}"];
}
