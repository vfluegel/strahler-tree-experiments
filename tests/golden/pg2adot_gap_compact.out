digraph attractor_decompositions {
  graph [rankdir=TB, ordering=out];
  node [shape=box];
  result [label="result (synthetic)"];
  even_empty [label=<<B>Even</B>: <I>W</I> = empty; no decomposition>];
  result -> even_empty;
  result -> odd;
  odd [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Odd</B> <I>d</I> = 3</TD></TR><TR><TD>|<I>W</I>| = 3</TD><TD>|<I>A</I>| = 0</TD></TR><TR><TD>nodes = 3</TD><TD>leaves = 2</TD></TR><TR><TD>height = 2</TD><TD>Strahler = 2</TD></TR></TABLE>>];
  odd -> odd_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><I>i</I> = 1</TD></TR><TR><TD>|<I>S</I><SUB><I>i</I></SUB>| = 1</TD><TD>|<I>A</I><SUB><I>i</I></SUB>| = 2</TD></TR></TABLE>>];
  odd_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Odd</B> <I>d</I> = 1</TD></TR><TR><TD>|<I>W</I>| = 1</TD><TD>|<I>A</I>| = 1</TD></TR></TABLE>>];
  odd -> odd_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><I>i</I> = 2</TD></TR><TR><TD>|<I>S</I><SUB><I>i</I></SUB>| = 1</TD><TD>|<I>A</I><SUB><I>i</I></SUB>| = 1</TD></TR></TABLE>>];
  odd_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Odd</B> <I>d</I> = 1</TD></TR><TR><TD>|<I>W</I>| = 1</TD><TD>|<I>A</I>| = 1</TD></TR></TABLE>>];
}
