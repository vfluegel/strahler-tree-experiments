  even_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Even</B> <I>d</I> = 2</TD></TR><TR><TD>|<I>V</I>| = 2</TD><TD>|<I>H</I>| = 1</TD></TR><TR><TD>|<I>T</I>| = 1</TD><TD>|<I>S</I>| = 0</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>V</I> = {1,2}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>H</I> = {1}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>T</I> = {2}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>S</I> = {}</TD></TR></TABLE>>];
  even_shaved_1 [style="dashed,filled", fillcolor=lightgray, label=<<B>shaved (Even)</B>, round 1: 4 vertices<BR/>{0,3,4,5}>];
  even -> even_shaved_1 [style=dashed];
  even_shaved_1 -> even_round_1;
  even_round_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Even</B> <I>d</I> = 4</TD></TR><TR><TD>|<I>D</I>| = 4</TD><TD>|<I>H</I>| = 1</TD></TR><TR><TD>|<I>T</I>| = 0</TD><TD>|<I>S</I>| = 0</TD></TR><TR><TD>nodes = 3</TD><TD>leaves = 1</TD></TR><TR><TD>height = 3</TD><TD>Strahler = 1</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>D</I> = {0,3,4,5}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>H</I> = {5}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>T</I> = {}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>S</I> = {}</TD></TR></TABLE>>];
