  odd_empty [label=<<B>Odd</B>: no decomposition of the remaining game; see shaved vertices>];
  result -> odd_empty;
  odd_shaved_1 [style="dashed,filled", fillcolor=lightgray, label=<<B>shaved (Odd)</B>, round 1: 1 vertices<BR/>{6}>];
  odd_empty -> odd_shaved_1 [style=dashed];
  odd_shaved_1 -> odd_round_1;
  odd_round_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Odd</B> <I>d</I> = 5</TD></TR><TR><TD>|<I>D</I>| = 1</TD><TD>|<I>H</I>| = 0</TD></TR><TR><TD>|<I>T</I>| = 0</TD><TD>|<I>S</I>| = 0</TD></TR><TR><TD>nodes = 3</TD><TD>leaves = 1</TD></TR><TR><TD>height = 3</TD><TD>Strahler = 1</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>D</I> = {6}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>H</I> = {}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>T</I> = {}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>S</I> = {}</TD></TR></TABLE>>];
