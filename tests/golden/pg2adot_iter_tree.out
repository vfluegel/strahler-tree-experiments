  odd_round_1_0_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Odd</B> <I>d</I> = 1</TD></TR><TR><TD>|<I>V</I>| = 1</TD><TD>|<I>H</I>| = 1</TD></TR><TR><TD>|<I>T</I>| = 0</TD><TD>|<I>S</I>| = 0</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>V</I> = {6}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>H</I> = {6}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>T</I> = {}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>S</I> = {}</TD></TR></TABLE>>];
