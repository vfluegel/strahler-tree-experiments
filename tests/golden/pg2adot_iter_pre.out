preprocess: residual=6 shaved_even=1 shaved_odd=0 single=0 loops=1 wcwc=0
Adaptive t: complete at t=0 (Even complete at t=0, Odd complete at t=0)
lifting: vertices=6 t_full=2 result=complete
iter-shave: rounds=2
iter-shave: round=1 t=0 shaved=4 even=4 odd=0
iter-shave: round=2 t=0 shaved=2 even=2 odd=0
lifting: first_complete_t=0 even_first_full_t=0 odd_first_full_t=0 budget_exhausted=no
lifting even: root_level=2 H=2 k_full=2 host=strahler K=1 t=0 host_nodes=2 host_leaves=1 positions=6 rounds=1 lifts=2 top=0 total_lifts=12 region=2 tree_nodes=2 tree_leaves=1 tree_height=2 strahler=1
lifting odd: root_level=1 H=1 k_full=1 host=strahler K=1 t=0 host_nodes=1 host_leaves=1 positions=3 rounds=1 lifts=2 top=2 total_lifts=8 region=0 tree_nodes=0 tree_leaves=0 tree_height=0 strahler=0
start: vertex=0 winner=even
digraph attractor_decompositions {
  graph [rankdir=TB, ordering=out];
  node [shape=box];
  result [label="result (synthetic)"];
  result -> even;
  even [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Even</B> <I>d</I> = 4</TD></TR><TR><TD>|<I>W</I>| = 2</TD><TD>|<I>A</I>| = 0</TD></TR><TR><TD>nodes = 2</TD><TD>leaves = 1</TD></TR><TR><TD>height = 2</TD><TD>Strahler = 1</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>W</I> = {1,2}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>A</I> = {}</TD></TR></TABLE>>];
  even -> even_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><I>i</I> = 1</TD></TR><TR><TD>|<I>S</I><SUB><I>i</I></SUB>| = 2</TD><TD>|<I>A</I><SUB><I>i</I></SUB>| = 2</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>S</I><SUB><I>i</I></SUB> = {1,2}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>A</I><SUB><I>i</I></SUB> = {1,2}</TD></TR></TABLE>>];
  even_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Even</B> <I>d</I> = 2</TD></TR><TR><TD>|<I>W</I>| = 2</TD><TD>|<I>A</I>| = 2</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>W</I> = {1,2}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>A</I> = {1,2}</TD></TR></TABLE>>];
  even_shaved [style="dashed,filled", fillcolor=lightgray, label=<<B>shaved (Even)</B>: 1 vertices<BR/>{6}>];
  even -> even_shaved [style=dashed];
  even_shaved_1 [style="dashed,filled", fillcolor=lightgray, label=<<B>shaved (Even)</B>, round 1, t=0: 4 vertices<BR/>{0,3,4,5}>];
  even -> even_shaved_1 [style=dashed];
  even_shaved_1 -> even_round_1;
  even_round_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Even</B> <I>d</I> = 4</TD></TR><TR><TD>|<I>D</I>| = 4</TD><TD>|<I>A</I>| = 0</TD></TR><TR><TD>nodes = 2</TD><TD>leaves = 1</TD></TR><TR><TD>height = 2</TD><TD>Strahler = 1</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>D</I> = {0,3,4,5}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>A</I> = {}</TD></TR></TABLE>>];
  even_round_1 -> even_round_1_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><I>i</I> = 1</TD></TR><TR><TD>|<I>S</I><SUB><I>i</I></SUB>| = 3</TD><TD>|<I>A</I><SUB><I>i</I></SUB>| = 4</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>S</I><SUB><I>i</I></SUB> = {0,3,5}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>A</I><SUB><I>i</I></SUB> = {0,3,4,5}</TD></TR></TABLE>>];
  even_round_1_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Even</B> <I>d</I> = 2</TD></TR><TR><TD>|<I>W</I>| = 3</TD><TD>|<I>A</I>| = 3</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>W</I> = {0,3,5}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>A</I> = {0,3,5}</TD></TR></TABLE>>];
  odd_empty [label=<<B>Odd</B>: <I>W</I> = empty; no decomposition>];
  result -> odd_empty;
}
